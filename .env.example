# Copy to .env.local. Never commit real keys or personal details.

# "gcp" calls Google Cloud Speech-to-Text, Translation and Text-to-Speech.
# "mock" (the default when unset) returns labeled example results with no
# network calls. It's for development only: a production server refuses to
# start unless this is "gcp".
LANGUAGE_PROVIDER=mock

# Google Cloud API key restricted to the three APIs above. Server-side only.
GOOGLE_API_KEY=

# Optional: absolute path to an ffmpeg binary. Defaults to the bundled ffmpeg-static.
# macOS example:   FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Windows example: FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Who operates the service, as named in the Terms of Use and Privacy Policy.
# A production server refuses to start until all four are set; in development
# the /privacy and /terms pages say which ones are missing.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_MAILING_ADDRESS=
# The US state whose law governs the Terms, for example: Colorado
LEGAL_GOVERNING_STATE=
